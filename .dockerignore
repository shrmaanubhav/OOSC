# API image build context -- keep this in sync with .gitignore's intent:
# committed data/reference and data/snapshots ARE needed in the image
# (that's what makes the demo work offline), everything else here is
# either regenerable, huge, or belongs to the other (web/) build context.

.git
.venv
__pycache__
*.pyc
.pytest_cache

# gitignored raw pulls -- large (PDFs, duckdb) and regenerated by ingest/,
# not needed for the committed-snapshot demo path
data/raw
data/snapshots/events/cache

# frontend has its own build context/.dockerignore
web/node_modules
web/.next
web/out

# secrets -- never bake a real key into an image layer
.env
.env.*
!.env.example

.claude
*.log
.DS_Store
Thumbs.db
