# Copy this file to .env and fill in what you have. Nothing here is
# required to run Phases 0-2; only the LLM_* block is needed for the
# Phase 3 event extractor (agent/extractor.py). Never commit .env itself
# -- it's gitignored.

# --- LLM backend (agent/llm.py) ---------------------------------------
# Which provider agent/extractor.py (and later agent/loop.py) calls.
# One of: groq | openai | gemini
LLM_PROVIDER=groq

# Optional: override the default model for the chosen provider.
# Defaults: groq=openai/gpt-oss-20b, openai=gpt-4.1-mini, gemini=gemini-3.6-flash
# LLM_MODEL=

# Only the key matching LLM_PROVIDER above is actually required, but
# fill in more than one if you want to switch providers later without
# coming back here.
GROQ_API_KEY=          # https://console.groq.com/keys
OPENAI_API_KEY=        # https://platform.openai.com/api-keys
GEMINI_API_KEY=        # https://aistudio.google.com/apikey

# Groq's free tier caps openai/gpt-oss-20b at 8000 tokens/minute -- the
# extractor caps articles per corridor so a run finishes in tens of
# minutes rather than hours. 0 = no cap (full backfill).
# EXTRACTOR_MAX_PER_CORRIDOR=500

# --- GDELT via BigQuery (ingest/gdelt_bigquery.py, primary GDELT path) -
# The DOC 2.0 API (ingest/gdelt.py) rate-limits too aggressively to be
# usable for a historical backfill -- see data/snapshots/gdelt/NOTE.md.
# 1. Create a free GCP project: https://console.cloud.google.com/projectcreate
# 2. Enable the BigQuery API: https://console.cloud.google.com/apis/library/bigquery.googleapis.com
# 3. IAM & Admin -> Service Accounts -> Create -> role "BigQuery Job User"
#    + "BigQuery Data Viewer" -> Keys tab -> Create new key -> JSON
GOOGLE_APPLICATION_CREDENTIALS=    # absolute path to the downloaded service-account JSON
GCP_PROJECT_ID=                    # the project id from step 1 (not the project name)

# --- ACLED (optional, conflict events -- not wired into any ingest script yet) -
# OAuth2 password grant, token expires in 24h -- store the credentials,
# not a token. https://developer.acleddata.com/
ACLED_USERNAME=
ACLED_PASSWORD=

# --- Tier 2 data sources (not needed yet -- deferred ingestion) -------
EIA_API_KEY=            # https://www.eia.gov/opendata/register.php
DATA_GOV_IN_API_KEY=    # https://data.gov.in -> log in -> open any dataset's "API" tab -> Generate API Key
