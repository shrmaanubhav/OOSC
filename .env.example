# Copy this file to .env and fill in what you have. Nothing here is
# required to run Phases 0-2; only the LLM_* block is needed for the
# Phase 3 event extractor (agent/extractor.py). Never commit .env itself
# -- it's gitignored.

# --- LLM backend (agent/llm.py) ---------------------------------------
# Which provider agent/extractor.py (and later agent/loop.py) calls.
# One of: groq | openai | gemini
LLM_PROVIDER=groq

# Optional: override the default model for the chosen provider.
# Defaults: groq=llama-3.1-8b-instant, openai=gpt-4.1-mini, gemini=gemini-2.0-flash
# LLM_MODEL=

# Only the key matching LLM_PROVIDER above is actually required, but
# fill in more than one if you want to switch providers later without
# coming back here.
GROQ_API_KEY=          # https://console.groq.com/keys
OPENAI_API_KEY=        # https://platform.openai.com/api-keys
GEMINI_API_KEY=        # https://aistudio.google.com/apikey

# --- Tier 2 data sources (not needed yet -- deferred ingestion) -------
EIA_API_KEY=            # https://www.eia.gov/opendata/register.php
DATA_GOV_IN_API_KEY=    # https://data.gov.in -> register -> API key on your profile page
